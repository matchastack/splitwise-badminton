# Copy to .env for local development. Never commit real values.

# Bot token from @BotFather.
BOT_TOKEN=
# Random string Telegram sends in X-Telegram-Bot-Api-Secret-Token (A-Z, a-z, 0-9, _ and -).
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=
# Neon pooled connection string (Connect → Connection pooling on), e.g.
# postgresql://user:pass@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
# Group chat ID (negative number). Run /chatid in the group to find it.
GROUP_CHAT_ID=
# Comma-separated Telegram user IDs allowed to run admin commands (ask @userinfobot).
ADMIN_TELEGRAM_IDS=
# Bearer token required by /api/cron (Vercel sends it automatically when set as CRON_SECRET).
CRON_SECRET=
# Days before a session that the attendance card is posted.
REMINDER_DAYS_BEFORE=2
# Court rate in cents per hour: a booking's suggested price is this × its court hours.
DEFAULT_COURT_RATE_CENTS=740

# Tests only: a throwaway Postgres database.
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/badminton_test
