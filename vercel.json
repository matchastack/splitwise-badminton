{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "sin1"
  ],
  "functions": {
    "api/telegram.py": {
      "includeFiles": "badminton/**"
    },
    "api/cron.py": {
      "includeFiles": "badminton/**"
    }
  },
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "0 2 * * *"
    }
  ]
}
